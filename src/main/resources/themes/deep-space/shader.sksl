uniform float2 resolution;
uniform float time;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / resolution;
    float t = time * 0.035;
    float2 p1 = (uv - float2(0.28 + 0.035 * sin(t), 0.34)) * float2(0.85, 1.25);
    float2 p2 = (uv - float2(0.78, 0.72 + 0.025 * cos(t * 1.3))) * float2(1.15, 0.8);
    float n = 0.5 + 0.5 * sin(uv.x * 7.0 + sin(uv.y * 5.0 + t) * 1.8 + t);
    float c1 = exp(-dot(p1, p1) * 5.0);
    float c2 = exp(-dot(p2, p2) * 4.0);
    float3 c = float3(0.018, 0.026, 0.065);
    c += float3(0.045, 0.075, 0.19) * c1 * (0.55 + 0.35 * n);
    c += float3(0.12, 0.055, 0.20) * c2 * (0.45 + 0.30 * n);
    return half4(c, 1.0);
}
